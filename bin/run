#!/usr/bin/env bash
# metaaivm — primary operation: run the metaaivm GitHub keyword harvester.
# Entry: collector.ts (incremental GH harvest, yote crontab) + dedup-rank.ts.
#
# Usage:
#   bin/run check         # fast gate: harvester sources type-check
#   bin/run collect       # run the collector (moon `collect` equivalent)
#   bin/run dedup-rank    # run the dedup/rank pass
set -euo pipefail
cd "$(dirname "$0")/.."
export RUN_FAST_ACTIVE=0
BUN="${BUN:-/home/toxic/.bun/bin/bun}"; [ -x "$BUN" ] || BUN=bun

case "${1:-collect}" in
  check) exec ./bin/check ;;
  collect) exec "$BUN" run collector.ts ;;
  dedup-rank) exec "$BUN" run dedup-rank.ts ;;
  *) exec "$BUN" run collector.ts ;;
esac