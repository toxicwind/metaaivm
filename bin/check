#!/usr/bin/env bash
# metaaivm — self-test gate (PASS/FAIL).
# GitHub keyword harvester (collector.ts + dedup-rank.ts). Gate = both sources
# type-check under tsc. No live GH harvest / network is performed.
set -euo pipefail
cd "$(dirname "$0")/.."
export RUN_FAST_ACTIVE=0
BUN="${BUN:-/home/toxic/.bun/bin/bun}"; [ -x "$BUN" ] || BUN=bun

echo "== metaaivm check: start =="
for f in collector.ts dedup-rank.ts; do
  [ -f "$f" ] || { echo "FAIL: $f missing"; exit 1; }
done

set +e
out="$("$BUN" x tsc --noEmit --skipLibCheck --target esnext --module esnext --moduleResolution bundler collector.ts dedup-rank.ts 2>&1)"
rc=$?
set -e
echo "$out"
[ "$rc" -eq 0 ] || { echo "FAIL: tsc rc=$rc"; exit 1; }

echo "== metaaivm check: PASS =="
exit 0